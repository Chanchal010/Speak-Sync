# ========================================
# Speak-Sync Environment Configuration Template
# ========================================
# Copy this file to .env and fill in your actual values

# ========================================
# DATABASE CONFIGURATION
# ========================================
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# RABBITMQ CONFIGURATION
# ========================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ========================================
# MONGODB CONFIGURATION
# ========================================
MONGODB_URI=mongodb://localhost:27017/speak_sync_lifestyle

# ========================================
# JWT CONFIGURATION
# ========================================
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_chars_CHANGE_ME
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars_CHANGE_ME
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ========================================
# INTERNAL API SECURITY
# ========================================
# Generate with: openssl rand -base64 48
INTERNAL_API_KEY=your_internal_api_key_CHANGE_ME

# ========================================
# AI SERVICE CONFIGURATION
# ========================================
# Get from: https://openrouter.ai/
GROQ_API_KEY=your_groq_api_key

# Get from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key

# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key

# AI Model Configuration
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=chatterbox

# AI Service Settings
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_TIMEOUT=30000

# ========================================
# SERVICE PORTS
# ========================================
GATEWAY_PORT=3000
SCHEDULER_PORT=3001
WORKER_PORT=3002
AI_BRAIN_PORT=8000
LIFESTYLE_PORT=8001

# ========================================
# SERVICE URLs (Internal Communication)
# ========================================
SCHEDULER_SERVICE_URL=http://scheduler-service:3001
AI_BRAIN_SERVICE_URL=http://ai-brain-service:8000
LIFESTYLE_SERVICE_URL=http://lifestyle-service:8001

# ========================================
# EXTERNAL API KEYS (Optional)
# ========================================
WEATHER_API_KEY=
NEWS_API_KEY=

# ========================================
# APPLICATION SETTINGS
# ========================================
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
