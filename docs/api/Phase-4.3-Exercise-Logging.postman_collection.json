{
	"info": {
		"name": "Phase 4.3 - Exercise Logging",
		"description": "Exercise tracking with RPE (Rate of Perceived Exertion) and recovery data for AI analysis",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create HIIT Workout Log",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "X-User-Id", "value": "{{USER_ID}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"habit_id\": \"{{EXERCISE_HABIT_ID}}\",\n  \"activity_type\": \"HIIT\",\n  \"duration\": 30,\n  \"intensity\": \"high\",\n  \"rpe\": 8,\n  \"post_activity_energy\": 7,\n  \"heart_rate_avg\": 145,\n  \"heart_rate_max\": 175,\n  \"calories_burned\": 350,\n  \"focus_areas\": [\"Full Body\", \"Cardio\"],\n  \"location\": \"home\",\n  \"workout_type\": \"solo\",\n  \"motivation_level\": 8,\n  \"mood_before\": \"neutral\",\n  \"mood_after\": \"energized\",\n  \"notes\": \"Felt great today!\"\n}"
				},
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs"]
				}
			}
		},
		{
			"name": "Create Running Log",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "X-User-Id", "value": "{{USER_ID}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"habit_id\": \"{{EXERCISE_HABIT_ID}}\",\n  \"activity_type\": \"Running\",\n  \"duration\": 45,\n  \"intensity\": \"moderate\",\n  \"rpe\": 6,\n  \"post_activity_energy\": 8,\n  \"heart_rate_avg\": 135,\n  \"heart_rate_max\": 160,\n  \"calories_burned\": 450,\n  \"distance\": 7.5,\n  \"focus_areas\": [\"Legs\", \"Cardio\"],\n  \"soreness_level\": 4,\n  \"sleep_quality_previous_night\": 7,\n  \"location\": \"outdoor\",\n  \"workout_type\": \"solo\",\n  \"motivation_level\": 7,\n  \"mood_before\": \"stressed\",\n  \"mood_after\": \"satisfied\",\n  \"notes\": \"Morning run, cleared my head\"\n}"
				},
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs"]
				}
			}
		},
		{
			"name": "Create Yoga Session Log",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "X-User-Id", "value": "{{USER_ID}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"habit_id\": \"{{EXERCISE_HABIT_ID}}\",\n  \"activity_type\": \"Yoga\",\n  \"duration\": 60,\n  \"intensity\": \"low\",\n  \"rpe\": 3,\n  \"post_activity_energy\": 8,\n  \"focus_areas\": [\"Flexibility\", \"Recovery\"],\n  \"soreness_level\": 2,\n  \"sleep_quality_previous_night\": 8,\n  \"location\": \"home\",\n  \"workout_type\": \"virtual\",\n  \"motivation_level\": 6,\n  \"mood_before\": \"anxious\",\n  \"mood_after\": \"energized\",\n  \"notes\": \"Needed this recovery day\"\n}"
				},
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs"]
				}
			}
		},
		{
			"name": "Create Exhausting Workout Log",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "X-User-Id", "value": "{{USER_ID}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"habit_id\": \"{{EXERCISE_HABIT_ID}}\",\n  \"activity_type\": \"Strength Training\",\n  \"duration\": 75,\n  \"intensity\": \"high\",\n  \"rpe\": 10,\n  \"post_activity_energy\": 3,\n  \"heart_rate_avg\": 130,\n  \"heart_rate_max\": 165,\n  \"calories_burned\": 500,\n  \"focus_areas\": [\"Upper Body\", \"Core\"],\n  \"soreness_level\": 8,\n  \"sleep_quality_previous_night\": 5,\n  \"location\": \"gym\",\n  \"workout_type\": \"trainer\",\n  \"motivation_level\": 9,\n  \"mood_before\": \"energetic\",\n  \"mood_after\": \"tired\",\n  \"notes\": \"Pushed too hard, feeling exhausted\"\n}"
				},
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs"]
				}
			}
		},
		{
			"name": "Get All Exercise Logs",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs"]
				}
			}
		},
		{
			"name": "Get Exercise Logs by Habit",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs?habit_id={{EXERCISE_HABIT_ID}}",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs"],
					"query": [{"key": "habit_id", "value": "{{EXERCISE_HABIT_ID}}"}]
				}
			}
		},
		{
			"name": "Get Exercise Logs by Activity Type",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs?activity_type=Running",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs"],
					"query": [{"key": "activity_type", "value": "Running"}]
				}
			}
		},
		{
			"name": "Get Exercise Logs by Date Range",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs?start_date=2025-12-01T00:00:00Z&end_date=2025-12-31T23:59:59Z",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs"],
					"query": [
						{"key": "start_date", "value": "2025-12-01T00:00:00Z"},
						{"key": "end_date", "value": "2025-12-31T23:59:59Z"}
					]
				}
			}
		},
		{
			"name": "Get Exercise Log by ID",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs/{{EXERCISE_LOG_ID}}",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs", "{{EXERCISE_LOG_ID}}"]
				}
			}
		},
		{
			"name": "Update Exercise Log",
			"request": {
				"method": "PUT",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "X-User-Id", "value": "{{USER_ID}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"post_activity_energy\": 9,\n  \"notes\": \"Actually felt amazing after rest!\"\n}"
				},
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs/{{EXERCISE_LOG_ID}}",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs", "{{EXERCISE_LOG_ID}}"]
				}
			}
		},
		{
			"name": "Delete Exercise Log",
			"request": {
				"method": "DELETE",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs/{{EXERCISE_LOG_ID}}",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs", "{{EXERCISE_LOG_ID}}"]
				}
			}
		},
		{
			"name": "Get Exercise Log Statistics",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs/stats/overview",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs", "stats", "overview"]
				}
			}
		},
		{
			"name": "Get Exercise Stats by Habit",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs/stats/overview?habit_id={{EXERCISE_HABIT_ID}}",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs", "stats", "overview"],
					"query": [{"key": "habit_id", "value": "{{EXERCISE_HABIT_ID}}"}]
				}
			}
		},
		{
			"name": "Get Exercise Stats by Date Range",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/exercise-logs/stats/overview?start_date=2025-12-01T00:00:00Z&end_date=2025-12-07T23:59:59Z",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "exercise-logs", "stats", "overview"],
					"query": [
						{"key": "start_date", "value": "2025-12-01T00:00:00Z"},
						{"key": "end_date", "value": "2025-12-07T23:59:59Z"}
					]
				}
			}
		}
	],
	"variable": [
		{"key": "LIFESTYLE_URL", "value": "http://localhost:8001", "type": "string"},
		{"key": "USER_ID", "value": "test-user-123", "type": "string"},
		{"key": "EXERCISE_HABIT_ID", "value": "", "type": "string"},
		{"key": "EXERCISE_LOG_ID", "value": "", "type": "string"}
	]
}
