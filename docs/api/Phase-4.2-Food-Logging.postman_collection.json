	"item": [
		{
			"name": "Create Breakfast Log",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-User-Id",
						"value": "{{USER_ID}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"habit_id\": \"{{FOOD_HABIT_ID}}\",\n  \"meal_type\": \"breakfast\",\n  \"food_items\": [\"Oatmeal\", \"Banana\", \"Almonds\", \"Honey\"],\n  \"portion_size\": \"medium\",\n  \"calories\": 350,\n  \"hunger_level\": 7,\n  \"satisfaction_level\": 8,\n  \"eating_speed\": \"moderate\",\n  \"emotional_state\": \"neutral\",\n  \"location\": \"home\",\n  \"social_context\": \"alone\",\n  \"distraction_level\": 3,\n  \"notes\": \"Felt energized after eating\"\n}"
				},
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/food-logs?habit_id={{FOOD_HABIT_ID}}",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "food-logs"],
					"query": [
						{
							"key": "habit_id",
							"value": "{{FOOD_HABIT_ID}}"
						}
					]
				}
			},
			"response": []
		},
