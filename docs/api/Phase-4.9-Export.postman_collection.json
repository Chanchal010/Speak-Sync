{
	"info": {
		"name": "Phase 4.9 - Export",
		"description": "Export habit data in CSV and JSON formats with calculated fields",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Export All Data as JSON",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/export/json",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "export", "json"]
				},
				"description": "Export all habit logs as JSON with calculated fields (chronotype, sleep_debt, hydration_status, stickiness%, over_training_risk, spending_pattern)"
			}
		},
		{
			"name": "Export All Data as CSV",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/export/csv",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "export", "csv"]
				},
				"description": "Export all habit logs as CSV files (separate file per habit type)"
			}
		},
		{
			"name": "Export Specific Habit Types (JSON)",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/export/json?habit_types=sleep&habit_types=water&habit_types=study",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "export", "json"],
					"query": [
						{"key": "habit_types", "value": "sleep", "description": "Export sleep logs with chronotype and sleep_debt"},
						{"key": "habit_types", "value": "water", "description": "Export water logs with hydration_status"},
						{"key": "habit_types", "value": "study", "description": "Export study logs with stickiness_percentage"}
					]
				},
				"description": "Export only selected habit types (sleep, water, study)"
			}
		},
		{
			"name": "Export with Date Range (JSON)",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/export/json?start_date=2025-12-01T00:00:00&end_date=2025-12-31T23:59:59",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "export", "json"],
					"query": [
						{"key": "start_date", "value": "2025-12-01T00:00:00", "description": "Export from December 1st"},
						{"key": "end_date", "value": "2025-12-31T23:59:59", "description": "Export until December 31st"}
					]
				},
				"description": "Export December 2025 data only"
			}
		},
		{
			"name": "Export Sleep + Study (CSV)",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/export/csv?habit_types=sleep&habit_types=study",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "export", "csv"],
					"query": [
						{"key": "habit_types", "value": "sleep"},
						{"key": "habit_types", "value": "study"}
					]
				},
				"description": "Export sleep and study logs as CSV with calculated metrics"
			}
		},
		{
			"name": "Export Last 7 Days (JSON)",
			"request": {
				"method": "GET",
				"header": [{"key": "X-User-Id", "value": "{{USER_ID}}"}],
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/export/json?start_date=2025-11-27T00:00:00",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "export", "json"],
					"query": [
						{"key": "start_date", "value": "2025-11-27T00:00:00", "description": "Last 7 days from Dec 4, 2025"}
					]
				},
				"description": "Export recent weekly data"
			}
		}
	],
	"variable": [
		{"key": "LIFESTYLE_URL", "value": "http://localhost:8001", "type": "string"},
		{"key": "USER_ID", "value": "test-user-123", "type": "string"}
	]
}
