{
	"info": {
		"name": "Phase 4.4 - Financial Tracking",
		"description": "Spending habit tracking with behavioral triggers and necessity scoring for AI analysis",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Impulse Shopping Log",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "X-User-Id", "value": "{{USER_ID}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"habit_id\": \"{{FINANCIAL_HABIT_ID}}\",\n  \"amount\": 89.99,\n  \"category\": \"shopping\",\n  \"description\": \"New sneakers (didn't need)\",\n  \"necessity_score\": 2,\n  \"associated_mood\": \"bored\",\n  \"location\": \"online\",\n  \"payment_method\": \"credit\",\n  \"impulse_buy\": true,\n  \"social_context\": \"alone\",\n  \"emotional_trigger\": \"boredom\",\n  \"regret_level\": 7,\n  \"notes\": \"Saw ad on Instagram, bought immediately\"\n}"
				},
				"url": {
					"raw": "{{LIFESTYLE_URL}}/api/financial-logs",
					"host": ["{{LIFESTYLE_URL}}"],
					"path": ["api", "financial-logs"]
				}
			}
		},
		{
